<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_3"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#713CCD"

    >


    <TextView
        android:id="@+id/allahuakbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اللَّهُ أَكْبَرُ \nআল্লাহু আকবার"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFEA00"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginTop="30dp"
        android:background="#673AB7"



        />


    <TextView
        android:id="@+id/alhamdulillah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="	ٱلْحَمْدُ لِلَّٰهِ\nআলহামদুলিল্লাহ "
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFEF00"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginTop="30dp"
        android:background="#673AB7"


        />



    <TextView
        android:id="@+id/subahanallah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="
سُبْحَانَ ٱللَّه\nসুবহানআল্লাহ"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFEF00"
        android:gravity="center"
        android:padding="10dp"
        android:layout_marginTop="30dp"
        android:background="#673AB7"


        />




</LinearLayout>
